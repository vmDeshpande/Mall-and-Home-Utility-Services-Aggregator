# Server Configuration
PORT=5000

# MongoDB - Use MongoDB Atlas for cloud deployment
# Local: mongodb://127.0.0.1:27017/servicehub
# Cloud: mongodb+srv://username:password@cluster0.mongodb.net/servicehub
MONGO_URI=mongodb+srv://username:password@cluster0.mongodb.net/servicehub

# JWT Secret - Use a long random string
JWT_SECRET=replace-with-a-long-random-secret

# Frontend URL for CORS
CLIENT_URL=http://localhost:3000

# Cloudinary Configuration (for image uploads)
CLOUD_NAME=your_cloudinary_cloud_name
API_KEY=your_cloudinary_api_key
API_SECRET=your_cloudinary_api_secret
